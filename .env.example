# sentinel-mcp configuration. Copy to .env and fill in what you need.
# A fresh checkout with an EMPTY file here is fully functional: the default
# posture is mock tools only, with every real side effect switched off.

APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=sqlite:///./sentinel_mcp.db

# --- Agent provider ---------------------------------------------------------
# "replay" runs a deterministic scripted provider: no network, no key, and the
# exact same governance path. Use it for tests and CI.
# "openai" (or any OpenAI-compatible endpoint) uses a real model.
AGENT_PROVIDER=replay
LLM_API_KEY=
LLM_MODEL=
# For DeepSeek / Kimi / Qwen / a local gateway, point this at the compatible
# /v1 endpoint instead of api.openai.com.
LLM_BASE_URL=

# --- Real side effects: all off by default ---------------------------------
ENABLE_REAL_CONNECTORS=false
ENABLE_REAL_WRITE_ACTIONS=false
ENABLE_REAL_DESTRUCTIVE_ACTIONS=false
ENABLE_REAL_EXTERNAL_ACTIONS=false

# --- Tool sandbox ----------------------------------------------------------
# Tools are confined to this root; paths escaping it are refused.
TOOL_SANDBOX_ROOT=./sandbox
HTTP_ALLOWLIST=api.github.com

# --- MCP servers (Phase 3) -------------------------------------------------
# Comma-separated "name=command" entries for stdio servers.
MCP_STDIO_SERVERS=
# Comma-separated "name=url" entries for Streamable HTTP servers.
MCP_HTTP_SERVERS=