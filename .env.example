# sentinel-mcp configuration. Copy to .env and fill in what you need.
# A fresh checkout with an EMPTY file here is fully functional: the default
# posture is mock tools only, with every real side effect switched off.

APP_ENV=development
LOG_LEVEL=info
LOG_JSON=true
DATABASE_URL=sqlite:///./sentinel_mcp.db
# Production example:
# DATABASE_URL=postgresql+psycopg://sentinel:change-me@127.0.0.1:5432/sentinel
AUTO_CREATE_SCHEMA=true

# --- HTTP service ----------------------------------------------------------
# JSON list of API keys. Each key binds one tenant, one role and one subject.
# Roles: viewer < operator < approver < admin. A fresh development checkout with
# an empty value gets a single labelled `dev-admin-key`; production refuses to
# start without explicit keys.
# Example (development only -- generate real keys with `openssl rand -hex 32`):
SENTINEL_API_KEYS_JSON=[{"key":"dev-admin-key","tenant":"dev","role":"admin","subject":"dev-admin"},{"key":"dev-approver-key","tenant":"dev","role":"approver","subject":"alice"}]
# Requests per tenant per minute. In-process; use a shared limiter for replicas.
RATE_LIMIT_PER_MINUTE=120
# Agent runs allowed to execute at once. Overflow gets 429 + Retry-After.
MAX_CONCURRENT_TASKS=8
# Optional bearer token for /metrics.
METRICS_TOKEN=

# --- tool resilience -------------------------------------------------------
ENABLE_TOOL_RETRIES=true
TOOL_RETRY_ATTEMPTS=2
TOOL_RETRY_BASE_DELAY=0.05
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=15

# --- audit chain -----------------------------------------------------------
# Empty means unkeyed: modification and deletion are detectable, a rewrite from
# genesis is not. Set a key held outside the database in any real deployment.
AUDIT_HMAC_KEY=

# --- Agent provider ---------------------------------------------------------
# "replay" runs a deterministic scripted provider: no network, no key, and the
# exact same governance path. Use it for tests and CI.
# "llm" (or "openai") uses a real model behind an OpenAI-compatible endpoint.
AGENT_PROVIDER=replay
LLM_API_KEY=
LLM_MODEL=
# For DeepSeek / Kimi / Qwen / a local gateway, point this at the compatible
# /v1 endpoint instead of api.openai.com.
LLM_BASE_URL=
# Whether the host's HTTP proxy configuration applies to model requests.
# Default false, and the default matters: a proxy meant for internet traffic is
# frequently wrong for a local or custom base URL, and the failure is a bare 502
# with an empty body that looks exactly like a broken backend. On the machine this
# was built on, a system proxy turned every request into a 502.
# Set true only when a remote endpoint genuinely has to be reached via a proxy.
LLM_USE_SYSTEM_PROXY=false
# Max turns before the loop stops. A model that will not finalise is halted rather
# than allowed to run indefinitely.
MAX_AGENT_TURNS=8

# --- MCP transports --------------------------------------------------------
# Same reasoning as LLM_USE_SYSTEM_PROXY above; per-server control lives on the
# server spec because a local stdio server never needs a proxy.

# --- Real side effects: all off by default ---------------------------------
ENABLE_REAL_CONNECTORS=false
ENABLE_REAL_WRITE_ACTIONS=false
ENABLE_REAL_DESTRUCTIVE_ACTIONS=false
ENABLE_REAL_EXTERNAL_ACTIONS=false

# --- Tool sandbox ----------------------------------------------------------
# Tools are confined to this root; paths escaping it are refused. The read-only SQL
# fixture lives here too, as sandbox/commerce.db (created on first run).
TOOL_SANDBOX_ROOT=./sandbox
# Hosts http_get may reach. Everything else is refused before a request is made, and
# so are private/loopback addresses even when the name is listed.
HTTP_ALLOWLIST=api.github.com

# --- Read-only GitHub connector --------------------------------------------
# Leave empty to serve a labelled fixture: every result reports source=fixture, so a
# reviewer is never misled about whether real data was fetched. Set a read-only
# token to enable live GETs. Read from the environment only and never returned by an
# API or written into an audit payload.
GITHUB_TOKEN=

# --- MCP servers (Phase 3) -------------------------------------------------
# Starting a third-party server is an explicit deployment decision.
ENABLE_MCP_SERVERS=false
# Comma-separated "name=command" entries for stdio servers.
MCP_STDIO_SERVERS=
# Comma-separated "name=url" entries for Streamable HTTP servers.
MCP_HTTP_SERVERS=